{
  "name": "@lcorg/capacitor-secure-storage",
  "version": "1.0.0-rc.0",
  "description": "Securely store string values in Capacitor applications using native iOS and Android storage mechanisms.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/plugin.mjs",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.cjs.js",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "author": "Lucian Ciolac",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run docs:generate && npm run build:typescript && npm run build:bundle",
    "build:typescript": "tsc",
    "build:bundle": "rollup -c rollup.config.mjs",
    "build:watch": "tsc --watch",
    "docs:generate": "docgen --api SecureStoragePlugin --output-readme README.md --output-json dist/docs.json",
    "prepack": "npm run build",
    "format": "npm run format:eslint && npm run format:prettier && npm run format:swift",
    "format:eslint": "eslint . --fix",
    "format:prettier": "prettier . --write",
    "format:swift": "node-swiftlint lint --fix --format",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:swift",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "lint:swift": "node-swiftlint lint",
    "test": "npm run test:web && npm run test:ios && npm run test:android",
    "test:package": "npm run build && node --test tests/package-smoke.test.cjs",
    "test:web": "npm run build && node --test tests/web.test.cjs",
    "test:ios": "node scripts/run-ios-tests.mjs",
    "test:android": "node scripts/run-android-tests.mjs",
    "test-app:setup": "npm run setup --workspace test-app",
    "test-app:start:web": "npm run start:web --workspace test-app",
    "test-app:build:web": "npm run build:web --workspace test-app",
    "test-app:build:android": "npm run build:android --workspace test-app",
    "test-app:build:ios": "npm run build:ios --workspace test-app",
    "verify": "npm run lint && npm test && npm run test:package",
    "release": "release-it"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "test-app"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@ionic/swiftlint-config": "^2.0.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-java": "^2.10.4",
    "release-it": "^21.1.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.4",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "android/variables.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "LcorgCapacitorSecureStorage.podspec",
    "LICENSE"
  ],
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "secure-storage",
    "keychain",
    "android-keystore",
    "encrypted-shared-preferences",
    "ios",
    "android",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucianciolac/capacitor-secure-storage.git"
  },
  "homepage": "https://github.com/lucianciolac/capacitor-secure-storage#readme",
  "bugs": {
    "url": "https://github.com/lucianciolac/capacitor-secure-storage/issues"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
